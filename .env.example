# PideADomicilio Platform Environment Variables
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=pedidosadomicilio

# File storage directory
FILE_STORAGE_PATH=/opt/filespad

# AES-128 Encryption Keys (16 characters each)
AES_SECRET_KEY=Inf12345Inf12345
AES_INIT_VECTOR=RandomInftVector

# Mongo Express UI
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
